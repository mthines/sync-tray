# Xcode
*.xcodeproj/project.xcworkspace/*
# ...except the SwiftPM lockfile: it pins every (transitive) package to an exact
# revision so CI/release builds can't silently pick up a new upstream version.
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.xcuserstate

# Build
build/
*.app

tasks

.mcp.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE
.idea/
*.swp
*.swo
*~

# Secrets
.env
.env.local
.env.*.local

# Node / Nx
node_modules/
.nx/
package-lock.json
yarn.lock
pnpm-lock.yaml
.agent/

# Local Xcode signing override (personal Team ID) — never commit
Config/Signing.local.xcconfig
